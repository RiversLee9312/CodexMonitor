<Window x:Class="CodexMonitor.App.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:local="using:CodexMonitor.App">
  <Grid x:Name="Root" Loaded="OnLoaded" SizeChanged="OnSizeChanged" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
    <Grid.RowDefinitions><RowDefinition Height="Auto" MinHeight="40"/><RowDefinition Height="*"/><RowDefinition Height="Auto" MinHeight="32"/></Grid.RowDefinitions>
    <Grid x:Name="TitleBar" Background="Transparent" Margin="16,0,140,0" FlowDirection="LeftToRight">
      <Grid.ColumnDefinitions><ColumnDefinition Width="24"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <Image Source="Assets/AppIcon.png" Width="24" Height="24" AutomationProperties.AccessibilityView="Raw"/>
      <TextBlock x:Name="AppTitle" Grid.Column="1" VerticalAlignment="Center" Margin="10,0,0,0" Style="{ThemeResource CaptionTextBlockStyle}"/>
    </Grid>
    <SplitView x:Name="Shell" Grid.Row="1" IsPaneOpen="True" DisplayMode="Inline" OpenPaneLength="320" PaneBackground="{ThemeResource SolidBackgroundFillColorBaseBrush}" LightDismissOverlayMode="On">
      <SplitView.Pane>
        <Grid Padding="16,12,12,8" RowSpacing="12">
          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
          <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <TextBlock x:Name="SessionsHeading" AutomationProperties.HeadingLevel="1" Style="{ThemeResource SubtitleTextBlockStyle}" VerticalAlignment="Center"/>
            <Button x:Name="NewButton" Grid.Column="1" Style="{StaticResource IconButtonStyle}" Click="OnNewSession"><FontIcon IsTextScaleFactorEnabled="False" Glyph="&#xE710;" FontSize="16"/></Button>
          </Grid>
          <AutoSuggestBox x:Name="SessionSearch" Grid.Row="1" TextChanged="OnSessionSearchChanged" QueryIcon="Find" MinHeight="40"/>
          <Grid Grid.Row="2" ColumnSpacing="12">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <ComboBox x:Name="SessionFilter" HorizontalAlignment="Stretch" SelectionChanged="OnFilterChanged" MinHeight="36"/>
            <Button x:Name="RefreshButton" Grid.Column="1" Style="{StaticResource IconButtonStyle}" Click="OnRefresh"><FontIcon IsTextScaleFactorEnabled="False" Glyph="&#xE72C;" FontSize="16"/></Button>
          </Grid>
          <Grid Grid.Row="3">
            <ListView x:Name="SessionList" SelectionMode="Single" SelectionChanged="OnSessionSelected" Padding="0,0,0,12" HorizontalContentAlignment="Stretch" Background="Transparent">
              <ListView.ItemsPanel><ItemsPanelTemplate><ItemsStackPanel ItemsUpdatingScrollMode="KeepItemsInView"/></ItemsPanelTemplate></ListView.ItemsPanel>
              <ListView.ItemContainerStyle><Style TargetType="ListViewItem"><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Padding" Value="10,12"/><Setter Property="Margin" Value="0,2"/><Setter Property="MinHeight" Value="84"/></Style></ListView.ItemContainerStyle>
              <ListView.ItemTemplate>
                <DataTemplate x:DataType="local:SessionRow">
                  <Grid RowSpacing="5" ToolTipService.ToolTip="{x:Bind AccessibleName, Mode=OneWay}" AutomationProperties.Name="{x:Bind AccessibleName, Mode=OneWay}">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <Grid ColumnSpacing="8">
                      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                      <TextBlock Text="{x:Bind Title, Mode=OneWay}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" MaxLines="1"/>
                      <Ellipse x:Name="UpdateDot" Grid.Column="1" Width="7" Height="7" VerticalAlignment="Center" Fill="{ThemeResource AccentTextFillColorPrimaryBrush}" Visibility="{x:Bind UpdatedVisibility, Mode=OneWay}" ToolTipService.ToolTip="{x:Bind UpdatedText, Mode=OneWay}" AutomationProperties.Name="{x:Bind UpdatedText, Mode=OneWay}"/>
                    </Grid>
                    <TextBlock Grid.Row="1" Text="{x:Bind Folder, Mode=OneWay}" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis"/>
                    <Grid Grid.Row="2">
                      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                      <Grid ColumnSpacing="6">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <FontIcon IsTextScaleFactorEnabled="False" x:Name="RunningGlyph" Glyph="&#xE768;" FontSize="16" VerticalAlignment="Center" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" Visibility="{x:Bind RunningVisibility, Mode=OneWay}" ToolTipService.ToolTip="{x:Bind RunningText, Mode=OneWay}" AutomationProperties.AccessibilityView="Raw"/>
                        <TextBlock Grid.Column="1" Text="{x:Bind State, Mode=OneWay}" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis"/>
                      </Grid>
                      <TextBlock Grid.Column="1" Text="{x:Bind Time, Mode=OneWay}" Margin="8,0,0,0" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                    </Grid>
                  </Grid>
                </DataTemplate>
              </ListView.ItemTemplate>
            </ListView>
            <StackPanel x:Name="NoSessionsPanel" Visibility="Collapsed" VerticalAlignment="Center" Spacing="8" Margin="8">
              <TextBlock x:Name="NoSessionsTitle" TextWrapping="Wrap" FontWeight="SemiBold"/>
              <TextBlock x:Name="NoSessionsHint" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
            </StackPanel>
          </Grid>
          <Button x:Name="SettingsButton" Grid.Row="4" HorizontalAlignment="Left" Style="{StaticResource IconButtonStyle}" Click="OnSettings"><FontIcon IsTextScaleFactorEnabled="False" Glyph="&#xE713;" FontSize="20"/></Button>
        </Grid>
      </SplitView.Pane>
      <Border Margin="0,8,12,0" Background="{ThemeResource LayerFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8">
        <Grid>
          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
          <InfoBar x:Name="Notice" IsOpen="False" IsClosable="True" Margin="12,12,12,0" Severity="Informational"/>
          <Grid Grid.Row="1" Margin="16,12" ColumnSpacing="12">
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <Button x:Name="PaneButton" Style="{StaticResource IconButtonStyle}" Visibility="Collapsed" Click="OnTogglePane" VerticalAlignment="Top"><FontIcon IsTextScaleFactorEnabled="False" Glyph="&#xE700;" FontSize="16"/></Button>
            <StackPanel Grid.Column="1" Spacing="4">
              <TextBlock x:Name="SessionTitle" AutomationProperties.HeadingLevel="1" FontSize="20" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" MaxLines="1"/>
              <TextBlock x:Name="SessionSubtitle" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" Style="{ThemeResource CaptionTextBlockStyle}"/>
            </StackPanel>
            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4">
              <Button x:Name="FindButton" Style="{StaticResource IconButtonStyle}" Click="OnFind"><FontIcon IsTextScaleFactorEnabled="False" Glyph="&#xE721;" FontSize="16"/></Button>
              <Button x:Name="MoreButton" Style="{StaticResource IconButtonStyle}"><FontIcon IsTextScaleFactorEnabled="False" Glyph="&#xE712;" FontSize="16"/>
                <Button.Flyout><MenuFlyout>
                  <MenuFlyoutItem x:Name="DetailsMenu" Click="OnDetails"><MenuFlyoutItem.Icon><FontIcon IsTextScaleFactorEnabled="False" Glyph="&#xE946;"/></MenuFlyoutItem.Icon></MenuFlyoutItem>
                  <MenuFlyoutItem x:Name="ExportMenu" Click="OnExport"><MenuFlyoutItem.Icon><FontIcon IsTextScaleFactorEnabled="False" Glyph="&#xE74E;"/></MenuFlyoutItem.Icon></MenuFlyoutItem>
                  <MenuFlyoutItem x:Name="OpenFolderMenu" Click="OnOpenFolder"><MenuFlyoutItem.Icon><FontIcon IsTextScaleFactorEnabled="False" Glyph="&#xE838;"/></MenuFlyoutItem.Icon></MenuFlyoutItem>
                  <MenuFlyoutSeparator/>
                  <MenuFlyoutItem x:Name="RetrySessionConnectionMenu" Click="OnRetrySessionAction"><MenuFlyoutItem.Icon><FontIcon IsTextScaleFactorEnabled="False" Glyph="&#xE72C;"/></MenuFlyoutItem.Icon></MenuFlyoutItem>
                  <MenuFlyoutItem x:Name="DisconnectMenu" Click="OnConnect"><MenuFlyoutItem.Icon><BitmapIcon UriSource="Assets/Icons/Disconnect.png" ShowAsMonochrome="True" Width="16" Height="16"/></MenuFlyoutItem.Icon></MenuFlyoutItem>
                </MenuFlyout></Button.Flyout>
              </Button>
            </StackPanel>
          </Grid>
          <Grid Grid.Row="2">
            <StackPanel x:Name="WelcomePanel" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="400" Margin="32" Spacing="12">
              <FontIcon IsTextScaleFactorEnabled="False" Glyph="&#xE8A5;" FontSize="32" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Margin="0,0,0,4" AutomationProperties.AccessibilityView="Raw"/>
              <TextBlock x:Name="WelcomeTitle" AutomationProperties.HeadingLevel="1" Style="{ThemeResource SubtitleTextBlockStyle}" TextAlignment="Center" TextWrapping="Wrap"/>
              <TextBlock x:Name="WelcomeHint" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextAlignment="Center" TextWrapping="Wrap"/>
              <Button x:Name="SetupCodexButton" HorizontalAlignment="Center" Visibility="Collapsed" Click="OnSetupCodex"/>
            </StackPanel>
            <Grid x:Name="Conversation" Visibility="Collapsed">
              <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
              <Grid x:Name="FindPanel" Visibility="Collapsed" Margin="24,0,24,12" ColumnSpacing="8">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBox x:Name="TranscriptSearch" TextChanged="OnTranscriptSearchChanged" MinHeight="40"/>
                <Button x:Name="CloseFindButton" Grid.Column="1" Style="{StaticResource IconButtonStyle}" Click="OnCloseFind"><FontIcon IsTextScaleFactorEnabled="False" Glyph="&#xE711;" FontSize="16"/></Button>
              </Grid>
              <Grid Grid.Row="1">
                <ListView x:Name="MessageList" Background="Transparent" SelectionMode="None" IsItemClickEnabled="False" HorizontalContentAlignment="Stretch" Padding="16,4,16,16" Loaded="OnMessageListLoaded" ScrollViewer.HorizontalScrollMode="Disabled" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                  <ListView.ItemsPanel><ItemsPanelTemplate><ItemsStackPanel ItemsUpdatingScrollMode="KeepItemsInView"/></ItemsPanelTemplate></ListView.ItemsPanel>
                  <ListView.ItemContainerStyle><Style TargetType="ListViewItem"><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Padding" Value="0"/><Setter Property="IsTabStop" Value="False"/><Setter Property="Margin" Value="0,0,0,16"/><Setter Property="AutomationProperties.Name" Value="{Binding AccessibleName}"/></Style></ListView.ItemContainerStyle>
                  <ListView.ItemTemplate><DataTemplate x:DataType="local:EntryRow"><local:TranscriptCard Row="{x:Bind}" HorizontalAlignment="Stretch" MaxWidth="920"/></DataTemplate></ListView.ItemTemplate>
                </ListView>
                <TextBlock x:Name="NoMessagesText" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                <ProgressRing x:Name="LoadingRing" IsActive="False" Width="32" Height="32" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>
              </Grid>
              <Button x:Name="LatestButton" Grid.Row="2" HorizontalAlignment="Right" Margin="24,0,24,8" Visibility="Collapsed" Click="OnLatest"/>
              <Border x:Name="SessionFooter" Grid.Row="3" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,1,0,0" Padding="24,16,24,18">
                <Grid MaxWidth="920" RowSpacing="12">
                  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                  <TextBox x:Name="Composer" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="72" MaxHeight="200" ScrollViewer.VerticalScrollBarVisibility="Auto" TextChanged="OnComposerChanged"/>
                  <StackPanel x:Name="SessionSetupHelp" Spacing="6">
                    <TextBlock x:Name="RestoreExplanation" FontSize="13" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    <TextBlock x:Name="ConnectExplanation" FontSize="13" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                  </StackPanel>
                  <TextBlock x:Name="ArchiveExplanation" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Visibility="Collapsed"/>
                  <Grid x:Name="SessionSetupActions" Grid.Row="1" ColumnSpacing="12">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <Grid x:Name="SessionServerChecking" ColumnSpacing="8" Visibility="Collapsed" VerticalAlignment="Center" AutomationProperties.LiveSetting="Polite">
                      <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                      <ProgressRing x:Name="SessionServerCheckingRing" Width="16" Height="16" IsActive="False" VerticalAlignment="Center" AutomationProperties.AccessibilityView="Raw"/>
                      <TextBlock x:Name="SessionServerCheckingText" Grid.Column="1" FontSize="13" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    </Grid>
                    <Grid x:Name="SessionConnectionUnavailable" ColumnSpacing="8" Visibility="Collapsed" VerticalAlignment="Center" AutomationProperties.LiveSetting="Polite">
                      <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                      <FontIcon IsTextScaleFactorEnabled="False" Glyph="&#xE7BA;" FontSize="16" Foreground="{ThemeResource SystemFillColorCautionBrush}" VerticalAlignment="Top" Margin="0,2,0,0" AutomationProperties.AccessibilityView="Raw"/>
                      <TextBlock x:Name="SessionConnectionReason" Grid.Column="1" FontSize="13" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    </Grid>
                    <Button x:Name="ResumeButton" Grid.Column="1" Click="OnResume" MinHeight="40" VerticalAlignment="Bottom"><TextBlock x:Name="ResumeLabel" TextWrapping="Wrap" MaxWidth="170"/></Button>
                    <Button x:Name="SessionConnectButton" Grid.Column="2" Click="OnSessionConnect" MinHeight="40" VerticalAlignment="Bottom"><TextBlock x:Name="SessionConnectLabel" TextWrapping="Wrap" MaxWidth="190"/></Button>
                  </Grid>
                  <Grid x:Name="ComposerActions" Grid.Row="1" ColumnSpacing="16">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <TextBlock x:Name="ComposerHint" VerticalAlignment="Center" TextWrapping="Wrap" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    <Button x:Name="StopButton" Grid.Column="1" Click="OnStop" MinHeight="40"/>
                    <Button x:Name="SendButton" Grid.Column="2" Click="OnSend" Style="{StaticResource AccentButtonStyle}" MinHeight="40" MinWidth="88"/>
                  </Grid>
                </Grid>
              </Border>
            </Grid>
          </Grid>
        </Grid>
      </Border>
    </SplitView>
    <TextBlock x:Name="SessionCount" Grid.Row="2" Margin="20,0" HorizontalAlignment="Right" VerticalAlignment="Center" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
  </Grid>
</Window>
