<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="using:CodexMonitor.App">
  <DataTemplate x:Key="RepeaterListContainer"><local:RepeaterListItem/></DataTemplate>
  <Style TargetType="FontIcon"><Setter Property="IsTextScaleFactorEnabled" Value="False"/></Style>
  <Style x:Key="IconButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
    <Setter Property="MinWidth" Value="40"/><Setter Property="MinHeight" Value="40"/>
    <Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/>
  </Style>
</ResourceDictionary>
