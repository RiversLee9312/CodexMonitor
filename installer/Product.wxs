<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Package Name="Codex Monitor" Manufacturer="RiversLee9312" Version="$(var.ProductVersion)"
           UpgradeCode="F827D616-A327-43D0-A38B-C1D07151BA40" Scope="perUser" InstallerVersion="500" Language="1033">
    <MajorUpgrade DowngradeErrorMessage="A newer version of Codex Monitor is already installed."/>
    <MediaTemplate EmbedCab="yes" CompressionLevel="high"/>
    <Icon Id="AppIcon" SourceFile="$(var.AppIcon)"/>
    <Property Id="ARPPRODUCTICON" Value="AppIcon"/>
    <Property Id="ARPURLINFOABOUT" Value="https://github.com/RiversLee9312/CodexMonitor"/>
    <Property Id="ARPNOMODIFY" Value="1"/>
    <StandardDirectory Id="LocalAppDataFolder">
      <Directory Id="UserPrograms" Name="Programs"><Directory Id="INSTALLFOLDER" Name="CodexMonitor"/></Directory>
    </StandardDirectory>
    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="AppMenuFolder" Name="Codex Monitor">
        <Component Id="StartMenuShortcut" Guid="05B174E0-18EB-4071-B634-AC74577EB9D7">
          <Shortcut Id="StartMenuApp" Name="Codex Monitor" Target="[INSTALLFOLDER]CodexMonitor.App.exe" WorkingDirectory="INSTALLFOLDER" Icon="AppIcon"/>
          <RemoveFolder Id="RemoveAppMenuFolder" On="uninstall"/>
          <RegistryValue Root="HKCU" Key="Software\CodexMonitor\Installer" Name="Installed" Type="integer" Value="1" KeyPath="yes"/>
        </Component>
      </Directory>
    </StandardDirectory>
    <Feature Id="Application" Title="Codex Monitor" Level="1">
      <ComponentGroupRef Id="ApplicationFiles"/><ComponentRef Id="StartMenuShortcut"/>
    </Feature>
  </Package>
</Wix>
